# KurRadar needs no API keys or accounts — every source is public.

POSTGRES_USER=kurradar
POSTGRES_PASSWORD=kurradar_local
POSTGRES_DB=kurradar
# docker compose publishes Postgres on 127.0.0.1:55460
DATABASE_URL=postgresql://kurradar:kurradar_local@127.0.0.1:55460/kurradar
TEST_DATABASE_URL=postgresql://kurradar:kurradar_local@127.0.0.1:55460/kurradar_test

RAW_DATA_DIR=data/raw
# polite crawling of tcmb.gov.tr
TCMB_MIN_INTERVAL_SECONDS=0.25
